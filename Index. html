function equitySvg(T){
  const t=sortTrades(T);let b=+S.start||0;const pts=[b];
  t.forEach(x=>{b+=x.pnl;pts.push(b);});
  const W=800,H=250,L=64,R=16,Tp=14,B=28;
  let mn=Math.min(...pts),mx=Math.max(...pts);
  if(mn===mx){mn-=1;mx+=1;}
  const pad=(mx-mn)*.12;mn-=pad;mx+=pad;
  const X=i=>L+(W-L-R)*i/(pts.length-1);
  const Y=v=>Tp+(H-Tp-B)*(1-(v-mn)/(mx-mn));
  const line=pts.map((v,i)=>(i?'L':'M')+X(i).toFixed(1)+' '+Y(v).toFixed(1)).join(' ');
  const last=pts.length-1;
  const area=line+` L${X(last).toFixed(1)} ${H-B} L${L} ${H-B} Z`;
  let grid='';
  for(let i=0;i<=4;i++){const v=mn+(mx-mn)*i/4,y=Y(v).toFixed(1);
    grid+=`<line class="gl" x1="${L}" x2="${W-R}" y1="${y}" y2="${y}"/><text x="${L-8}" y="${(+y)+4}" text-anchor="end">${compact(v)}</text>`;}
  const s0=+S.start||0,sy=Y(s0).toFixed(1),up=pts[last]>=s0;
  return `<svg class="chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="Equity curve from ${money(s0)} to ${money(pts[last])} over ${t.length} trades">${grid}<line class="base" x1="${L}" x2="${W-R}" y1="${sy}" y2="${sy}"/><path class="area" d="${area}"/><path class="ln" d="${line}"/><circle class="dot ${up?'pos':'neg'}" cx="${X(last).toFixed(1)}" cy="${Y(pts[last]).toFixed(1)}" r="4.5"/><text x="${L}" y="${H-8}">Start</text><text x="${W-R}" y="${H-8}" text-anchor="end">Trade ${t.length}</text></svg>`;
}

/* P&L calendar */
const cellMoney=n=>{
  const a=Math.abs(n);
  const s=a>=1000?(a/1000).toFixed(a>=10000?0:1).replace(/\.0$/,'')+'k':(a%1?a.toFixed(2):String(a));
  return (n<0?'\u2212':n>0?'+':'')+esc(S.cur)+s;
};
function dayMap(){
  const m={};
  S.trades.forEach(t=>{
    const d=m[t.date]||(m[t.date]={pnl:0,n:0,w:0,l:0,be:0,r:0,hasR:false,gs:[],noTrade:false});
    if(t.noTrade){d.noTrade=true;return;}
    if(t.outcome==='missed')return;
    d.n++;d.pnl+=t.pnl;
    if(t.outcome==='win')d.w++;else if(t.outcome==='loss')d.l++;else d.be++;
    if(t.r!=null){d.r+=t.r;d.hasR=true;}
    if(t.grade)d.gs.push(GRADES.indexOf(t.grade));
  });
  return m;
}
function dayCell(ds,day,d,show,isToday){
  let inner=`<span class="dn">${day}</span>`;
  const has=d&&d.n>0;
  if(has){
    if(show.pnl)inner+=`<span class="dp num ${cls(d.pnl)}">${cellMoney(d.pnl)}</span>`;
    const bits=[];
    if(show.trades)bits.push(`${d.n} ${d.n===1?'trade':'trades'}`);
    if(show.wl)bits.push(`${d.w}W ${d.l}L`);
    if(show.winp)bits.push(`${Math.round(d.w/d.n*100)}% won`);
    if(show.r&&d.hasR)bits.push(fmtR(d.r));
    if(show.be&&d.be)bits.push(`${d.be} BE`);
    if(show.grade&&d.gs.length)bits.push('Grade '+GRADES[Math.round(d.gs.reduce((a,b)=>a+b,0)/d.gs.length)]);
    inner+=bits.map(b=>`<span class="ds">${esc(b)}</span>`).join('');
  }
  const showNT=!!(d&&d.noTrade&&show.notrade);
  if(showNT)inner+='<span class="dnt">No trade</span>';
  const tone=has?(d.pnl>0?'up':d.pnl<0?'down':''):'';
  const label=fmtDate(ds)+(has?`, ${money(d.pnl,true)}, ${d.n} ${d.n===1?'trade':'trades'}`:'')+(showNT?', no trade day':'');
  return `<button type="button" class="day ${tone} ${showNT&&!has?'nt':''} ${isToday?'today':''}" data-act="calday" data-d="${ds}" aria-label="${esc(label)}. Log a trade for this day">${inner}</button>`;
}
function calendarCard(){
  const dm=dayMap(),show=S.calShow||{},todayStr=ymd(new Date());
  const pad=n=>String(n).padStart(2,'0');
  const dim=new Date(calY,calM+1,0).getDate(),startDow=new Date(calY,calM,1).getDay();
  const cells=[];
  for(let i=0;i<startDow;i++)cells.push(0);
  for(let d=1;d<=dim;d++)cells.push(d);
  while(cells.length%7)cells.push(0);
  let mp=0,mn=0,grid='';
  for(let r=0;r<cells.length/7;r++){
    let wp=0,wn=0;
    for(let c=0;c<7;c++){
      const day=cells[r*7+c];
      if(!day){grid+='<div class="day off" aria-hidden="true"></div>';continue;}
      const ds=calY+'-'+pad(calM+1)+'-'+pad(day),d=dm[ds];
      if(d){wp+=d.pnl;wn+=d.n;}
      grid+=dayCell(ds,day,d,show,ds===todayStr);
    }
    mp+=wp;mn+=wn;
    grid+=`<div class="day wk"><span class="dp num ${cls(wp)}">${cellMoney(wp)}</span><span class="ds">${wn} ${wn===1?'trade':'trades'}</span></div>`;
  }
  const title=new Date(calY,calM,1).toLocaleDateString(undefined,{month:'long',year:'numeric'});
  const toggles=[['pnl','P&amp;L'],['trades','Trades'],['wl','W/L'],['winp','Win %'],['r','R'],['be','BE'],['notrade','No trade'],['grade','Grade']]
    .map(([k,l])=>`<button class="chipb" data-act="calshow" data-k="${k}" aria-pressed="${!!show[k]}">${l}</button>`).join('');
  return `<section class="card" aria-label="Calendar">
    <div class="cal-head">
      <div class="cal-nav"><button class="icon" data-act="calprev" aria-label="Previous month">${ic('left',18)}</button><h2>${esc(title)}</h2><button class="icon" data-act="calnext" aria-label="Next month">${ic('right',18)}</button><button class="btn ghost" data-act="caltoday">Today</button></div>
      <div class="cal-sum"><div><span>Month P&amp;L</span><b class="num ${cls(mp)}">${money(mp,true)}</b></div><div><span>Trades</span><b class="num">${mn}</b></div></div>
    </div>
    <div class="chips cal-show" role="group" aria-label="Show on each day">${toggles}</div>
    <div class="cal">${['Sun','Mon','Tue','Wed','Thu','Fri','Sat','Week'].map(x=>`<div class="dh">${x}</div>`).join('')}${grid}</div>
  </section>`;
}

