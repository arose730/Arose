function pillRow(list){return list.map(x=>`<span class="pill">${esc(x)}</span>`).join('');}
function dayEntryCard(t){
  const isNT=t.noTrade;
  const head=isNT
    ?`<div class="dc-head"><span class="oc missed">No trade day</span></div>`
    :`<div class="dc-head"><b>${esc(t.symbol)}</b><span class="side-tag ${t.dir==='short'?'short':'long'}">${t.dir==='short'?'Short':'Long'}</span><span class="oc ${esc(t.outcome)}">${esc(OUT_LABEL[t.outcome]||'')}</span>${t.broke?'<span class="oc warn">Rule broken</span>':''}<span class="num ${cls(t.pnl)}">${t.outcome==='missed'?money(t.amount||0):money(t.pnl,true)}</span></div>`;
  const metaBits=[];
  if(!isNT){
    if(t.r!=null)metaBits.push(fmtR(t.r));
    if(t.grade)metaBits.push('Grade '+t.grade);
    if(t.session&&t.session!=='None')metaBits.push(t.session);
    if(t.model)metaBits.push(`${esc(t.model.name)} ${t.mdone}/${t.mtotal}`);
    if(t.tags&&t.tags.length)metaBits.push(t.tags.map(x=>'#'+x).join(' '));
  }
  const meta=metaBits.length?`<p class="hint" style="margin-top:4px">${metaBits.join(' \u00b7 ')}</p>`:'';
  const feel=(t.feelings&&t.feelings.length)?`<div style="margin-top:10px">${pillRow(t.feelings)}</div>`:'';
  const notes=t.notes?`<p class="quote">\u201c${esc(t.notes)}\u201d</p>`:'';
  const shots=(t.shots&&t.shots.length)?`<div class="thumbs" style="margin-top:10px">${t.shots.map((s,i)=>`<button type="button" class="thumb thumb-btn" data-act="zoom" data-src="${esc(s)}" aria-label="View screenshot ${i+1} full size"><img src="${esc(s)}" alt="Chart screenshot ${i+1}"></button>`).join('')}</div>`:'';
  return `<div class="card daycard">${head}${meta}${feel}${notes}${shots}
    <div style="margin-top:14px"><button type="button" class="btn" data-act="edit" data-id="${esc(t.id)}">${ic('edit',15)}Edit ${isNT?'this day':'this trade'}</button></div>
  </div>`;
}
function openDayDetail(ds){
  const trades=S.trades.filter(t=>t.date===ds);
  if(!trades.length){openTrade(null,ds);return;}
  const real=trades.filter(isReal),net=sum(real);
  $('#ddlgTitle').textContent=fmtDate(ds);
  $('#ddSummary').innerHTML=real.length?`<span class="num ${cls(net)}">${money(net,true)}</span> \u00b7 ${trades.length} ${trades.length===1?'entry':'entries'}`:`${trades.length} ${trades.length===1?'entry':'entries'}`;
  $('#ddBody').innerHTML=sortTrades(trades).map(dayEntryCard).join('');
  ddlg.dataset.date=ds;
  if(ddlg.showModal)ddlg.showModal();else ddlg.setAttribute('open','');
}
function closeDayDetail(){if(ddlg.close)ddlg.close();else ddlg.removeAttribute('open');}
ddlg.addEventListener('click',e=>{if(e.target===ddlg)closeDayDetail();});

