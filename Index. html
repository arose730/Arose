<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Arose TradeLab</title>
<link rel="manifest" href="data:application/manifest+json;base64,">
<link rel="icon" type="image/png" sizes="192x192" href="data:image/png;base64,">
<link rel="icon" type="image/png" sizes="512x512" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<meta name="theme-color" content="#0b0b10">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Journal">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap">
<style>
:root{
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --bg:#f3f3f7;--panel:#ffffff;--raised:#f6f6fa;--line:#e1e1ea;
  --text:#16161d;--muted:#666677;
  --accent:#6a59e0;--accent2:#8577f0;--ink:#ffffff;
  --pos:#0b8a5e;--neg:#cc3d3d;--amber:#a86a00;
  --bar-pos:#22b07d;--bar-neg:#e05a5a;--scrim:rgba(20,20,30,.45);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --bg:#0b0b10;--panel:#13131a;--raised:#1a1a23;--line:#262631;
    --text:#ececf2;--muted:#8d8d9e;
    --accent:#8b7cf6;--accent2:#b3a8ff;--ink:#0b0b10;
    --pos:#3ddc9b;--neg:#ff7a7a;--amber:#f0b45a;
    --bar-pos:#2fbf88;--bar-neg:#e5646a;--scrim:rgba(4,4,8,.66);
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#0b0b10;--panel:#13131a;--raised:#1a1a23;--line:#262631;
  --text:#ececf2;--muted:#8d8d9e;
  --accent:#8b7cf6;--accent2:#b3a8ff;--ink:#0b0b10;
  --pos:#3ddc9b;--neg:#ff7a7a;--amber:#f0b45a;
  --bar-pos:#2fbf88;--bar-neg:#e5646a;--scrim:rgba(4,4,8,.66);
}
:root[data-theme="sage"]{
  color-scheme:light;
  --bg:#C7D7C3;--panel:#F4F8F2;--raised:#DCE8D8;--line:#A9C1A3;
  --text:#1E2B1B;--muted:#5B6E55;
  --accent:#6a59e0;--accent2:#8577f0;--ink:#ffffff;
  --pos:#1F7A4D;--neg:#B23B3B;--amber:#8A6100;
  --bar-pos:#2F9463;--bar-neg:#C24B4B;--scrim:rgba(20,30,15,.45);
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--text);font:400 14px/1.5 'Manrope',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;-webkit-font-smoothing:antialiased}
button,input,textarea,select{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent2);outline-offset:2px}
.num{font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.pos{color:var(--pos)}.neg{color:var(--neg)}.muted{color:var(--muted)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
fieldset{border:0;margin:0;padding:0;min-width:0}
legend{padding:0;margin:0 0 7px;font-weight:600;font-size:13px}

/* layout */
.app{height:100%;display:grid;grid-template-columns:232px minmax(0,1fr)}
.side{display:flex;flex-direction:column;gap:22px;padding:20px 12px 16px;border-right:1px solid var(--line);background:var(--panel);overflow-y:auto;min-height:0}
.main{overflow-y:auto;min-width:0;min-height:0;padding:28px clamp(16px,3.2vw,44px) 56px}
.main:focus{outline:none}
.wrap{max-width:1080px;margin:0 auto}

.brand{display:flex;align-items:center;gap:11px;padding:0 6px}
.brand b{display:block;font-size:15px;line-height:1.25;overflow-wrap:anywhere}
.brand small{display:block;color:var(--muted);font-size:12px}
.mark{flex:none;width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:var(--raised);border:1px solid var(--line);color:var(--accent2)}
.nav{display:flex;flex-direction:column;gap:4px}
.nav button{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:11px;border:1px solid transparent;background:transparent;color:var(--muted);cursor:pointer;font-weight:600;text-align:left}
.nav button:hover{color:var(--text);background:var(--raised)}
.nav button[aria-current="page"]{color:var(--text);background:color-mix(in srgb,var(--accent) 14%,transparent);border-color:color-mix(in srgb,var(--accent) 45%,transparent)}
.nav button[aria-current="page"] svg{color:var(--accent2)}
.side-foot{margin-top:auto;padding:0 8px;color:var(--muted);font-size:12px}
.side-foot.acct{display:flex;align-items:center;gap:8px}
.acct-av{width:22px;height:22px;border-radius:999px;flex:none;object-fit:cover}

.head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:22px}
.head h1{margin:0;font-size:26px;line-height:1.2;font-weight:700;letter-spacing:-.02em}
.head .date{margin:2px 0 0;color:var(--muted)}

/* controls */
.btn{display:inline-flex;align-items:center;gap:8px;padding:9px 15px;border-radius:10px;border:1px solid var(--line);background:var(--raised);cursor:pointer;font-weight:600;font-size:13.5px;white-space:nowrap}
.btn:hover{border-color:var(--muted)}
.btn.primary{background:linear-gradient(135deg,var(--accent2),var(--accent));border-color:transparent;color:var(--ink)}
.btn.primary:hover{filter:brightness(1.07)}
.btn.danger{color:var(--neg);border-color:color-mix(in srgb,var(--neg) 45%,var(--line))}
.btn.ghost{background:transparent}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.icon{flex:none;width:32px;height:32px;display:grid;place-items:center;border-radius:8px;border:0;background:transparent;color:var(--muted);cursor:pointer}
.icon:hover{background:var(--raised);color:var(--text)}
input:not([type=radio]):not([type=checkbox]):not([type=range]):not([type=file]),textarea,select{width:100%;padding:10px 12px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--text)}
input::placeholder,textarea::placeholder{color:var(--muted);opacity:.8}
input:not([type=radio]):not([type=checkbox]):not([type=range]):not([type=file]):focus,textarea:focus,select:focus{outline:2px solid var(--accent2);outline-offset:0;border-color:transparent}
textarea{resize:vertical;min-height:84px}

.seg{display:inline-flex;padding:3px;gap:3px;border-radius:11px;background:var(--bg);border:1px solid var(--line)}
.seg.full{display:flex}.seg.full label{flex:1}.seg.full span{text-align:center}
.seg label{position:relative;cursor:pointer}
.seg input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.seg span{display:block;padding:8px 14px;border-radius:8px;font-weight:600;color:var(--muted);white-space:nowrap}
.seg input:checked+span{background:var(--raised);color:var(--text);box-shadow:inset 0 0 0 1px var(--accent)}
.seg .o-win input:checked+span{color:var(--pos);box-shadow:inset 0 0 0 1px var(--pos)}
.seg .o-loss input:checked+span{color:var(--neg);box-shadow:inset 0 0 0 1px var(--neg)}
.seg .o-missed input:checked+span{color:var(--amber);box-shadow:inset 0 0 0 1px var(--amber)}
.seg input:focus-visible+span{outline:2px solid var(--accent2);outline-offset:1px}

/* cards */
.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px;margin-bottom:16px}
.card h2{margin:0;font-size:15px;font-weight:700}
.cl-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}
.prog{color:var(--muted);font-size:13px}
.empty{color:var(--muted);margin:8px 0 4px}
.empty-card{text-align:center;padding:44px 20px}
.empty-card p{color:var(--muted);margin:6px 0 18px}
.note{color:var(--muted);margin:8px 0 14px;max-width:62ch}

.hero{border-radius:22px;padding:26px clamp(20px,3vw,32px)}
.lbl{color:var(--muted);font-weight:600}
.big{font-size:clamp(38px,7vw,60px);line-height:1.1;font-weight:700;margin:6px 0 4px;overflow-wrap:anywhere}
.sub{margin:0 0 18px;color:var(--muted)}
.mini{display:flex;flex-wrap:wrap;gap:12px 36px;margin:0;padding-top:16px;border-top:1px solid var(--line)}
.mini div{min-width:110px}
.mini dt{color:var(--muted);font-size:12.5px}
.mini dd{margin:2px 0 0;font-size:16px;font-weight:700}

.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:16px}
.tile{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px 18px;display:flex;flex-direction:column;gap:4px;position:relative}
.tile .ti{position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:9px;display:grid;place-items:center;background:var(--raised);color:var(--muted)}
.tile .tl{color:var(--muted);font-weight:600;font-size:13px}
.tile .tv{font-size:24px;font-weight:700;margin-top:6px}
.tile .ts{color:var(--muted);font-size:12.5px}

.chart{display:block;width:100%;height:auto}
.chart text{fill:var(--muted);font:11px 'JetBrains Mono',ui-monospace,monospace}
.chart .gl{stroke:var(--line);stroke-width:1}
.chart .base{stroke:var(--muted);stroke-opacity:.55;stroke-dasharray:4 4}
.chart .area{fill:var(--accent);fill-opacity:.12}
.chart .ln{fill:none;stroke:var(--accent2);stroke-width:2.2;stroke-linejoin:round;stroke-linecap:round}
.chart .dot.pos{fill:var(--pos)}.chart .dot.neg{fill:var(--neg)}

/* tables */
.tblwrap{overflow-x:auto;margin:0 -8px}
.tbl{width:100%;min-width:660px;border-collapse:collapse}
.tbl th{padding:8px 10px;text-align:left;color:var(--muted);font-weight:600;font-size:12.5px;white-space:nowrap}
.tbl td{padding:12px 10px;border-top:1px solid var(--line);white-space:nowrap;vertical-align:middle}
.tbl .r{text-align:right}
.tbl tbody tr{cursor:pointer}
.tbl tbody tr:hover{background:var(--raised)}
.tbl small{display:block;color:var(--muted);font-size:12px;max-width:28ch;overflow:hidden;text-overflow:ellipsis}
.side-tag{font-weight:600}
.side-tag.long{color:var(--accent2)}.side-tag.short{color:var(--amber)}
.oc{display:inline-block;padding:2px 10px;border-radius:999px;font-weight:600;font-size:12.5px;border:1px solid var(--line);color:var(--muted)}
.oc.win{color:var(--pos);border-color:color-mix(in srgb,var(--pos) 50%,var(--line))}
.oc.loss{color:var(--neg);border-color:color-mix(in srgb,var(--neg) 50%,var(--line))}
.oc.missed,.oc.warn{color:var(--amber);border-color:color-mix(in srgb,var(--amber) 50%,var(--line))}
.oc+.oc{margin-left:6px}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chipb{padding:6px 14px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--muted);font-weight:600;cursor:pointer}
.chipb:hover{color:var(--text)}
.chipb[aria-pressed="true"]{color:var(--text);background:var(--raised);border-color:var(--accent)}

/* analytics */
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:16px}
.fact{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px}
.fact .fl{color:var(--muted);font-size:12.5px;font-weight:600}
.fact .fv{font-size:19px;font-weight:700;margin-top:2px}
.fact .fs{color:var(--muted);font-size:12px}
.cols2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:16px}
.cols2 .card{margin-bottom:0}
.bars{display:flex;flex-direction:column;gap:12px;margin-top:14px}
.brow{display:grid;grid-template-columns:minmax(90px,140px) minmax(0,1fr) auto;gap:14px;align-items:center}
.bl b{display:block;font-weight:600}
.bl small{display:block;color:var(--muted);font-size:12px}
.bbar{height:10px;border-radius:6px;background:var(--raised)}
.bbar i{display:block;height:100%;border-radius:6px}
.bbar i.pos{background:var(--bar-pos)}.bbar i.neg{background:var(--bar-neg)}
.bv{font-weight:700;text-align:right;min-width:88px}

/* checklists + settings */
.cl{list-style:none;margin:0 0 16px;padding:0}
.cl li{display:flex;align-items:center;gap:8px;border-top:1px solid var(--line);padding:4px 0}
.cl li:first-child{border-top:0}
.cl label{flex:1;display:flex;align-items:center;gap:12px;padding:9px 0;cursor:pointer}
.cl input{width:18px;height:18px;accent-color:var(--accent);margin:0;flex:none}
.cl input:checked+span{color:var(--muted);text-decoration:line-through}
.addrow{display:flex;gap:10px;margin-bottom:6px}
.addrow input{flex:1}
.form-card .row{display:grid;grid-template-columns:200px minmax(0,1fr);gap:8px 20px;align-items:center;padding:14px 0;border-top:1px solid var(--line)}
.form-card .row:first-child{border-top:0;padding-top:0}
.form-card .row:last-child{padding-bottom:0}
.form-card .row label,.form-card .rl{font-weight:600}
.form-card input.short{max-width:200px}
.btnrow{display:flex;gap:10px;flex-wrap:wrap;align-items:center}

/* dialog */
dialog{padding:0;border:1px solid var(--line);border-radius:18px;background:var(--panel);color:var(--text);width:min(640px,calc(100% - 24px));max-height:calc(100% - 24px);overflow:hidden}
dialog[open]{display:flex;flex-direction:column}
dialog::backdrop{background:var(--scrim)}
.dform{display:flex;flex-direction:column;min-height:0;flex:1}
.dhead{display:flex;justify-content:space-between;align-items:center;padding:16px 20px 12px}
.dhead h2{margin:0;font-size:18px}
.dbody{padding:4px 20px 12px;overflow-y:auto;min-height:0;flex:1}
.dbody>*+*{margin-top:18px}
.dfoot{display:flex;align-items:center;gap:10px;padding:14px 20px;border-top:1px solid var(--line)}
.dfoot .grow{flex:1}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.f{display:flex;flex-direction:column;gap:6px;font-weight:600;font-size:13px}
.hint{color:var(--muted);font-weight:400;font-size:12px;margin:0}
.err{color:var(--neg);min-height:1.4em;margin:0}
.tabs{display:flex}.tabs label{flex:1}.tabs span{text-align:center}
form[data-mode="none"] .t-only{display:none!important}

.chips2{display:flex;flex-wrap:wrap;gap:8px}
.chip{position:relative;cursor:pointer}
.chip input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.chip span{display:inline-block;padding:6px 13px;border-radius:999px;border:1px solid var(--line);color:var(--muted);font-weight:600;font-size:13px;background:var(--bg)}
.chip:hover span{color:var(--text)}
.chip input:checked+span{color:var(--text);background:color-mix(in srgb,var(--accent) 16%,var(--bg));border-color:var(--accent)}
.chip.p input:checked+span{background:color-mix(in srgb,var(--pos) 16%,var(--bg));border-color:var(--pos)}
.chip.n input:checked+span,.chip.rule input:checked+span{background:color-mix(in srgb,var(--neg) 16%,var(--bg));border-color:var(--neg)}
.chip input:focus-visible+span{outline:2px solid var(--accent2);outline-offset:2px}
.grades{display:flex;gap:8px;flex-wrap:wrap}
.grade{position:relative;cursor:pointer}
.grade input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.grade span{display:grid;place-items:center;width:48px;height:48px;border-radius:12px;border:1px solid var(--line);font-weight:700;font-size:16px;color:var(--muted);background:var(--bg)}
.grade:hover span{color:var(--text)}
.grade input:checked+span{color:var(--text);border-color:var(--accent);background:color-mix(in srgb,var(--accent) 16%,var(--bg))}
.grade input:focus-visible+span{outline:2px solid var(--accent2);outline-offset:2px}
.conf{display:flex;align-items:center;gap:14px}
.conf input{flex:1;accent-color:var(--accent);margin:0}
.conf output{min-width:68px;text-align:right;font-weight:700}
.mbox{display:flex;flex-direction:column;padding:6px 14px;border:1px solid var(--line);border-radius:10px;background:var(--bg);margin-top:8px}
.mbox label{display:flex;align-items:center;gap:10px;padding:7px 0;font-weight:500;font-size:14px;cursor:pointer}
.mbox input{accent-color:var(--accent);width:17px;height:17px;margin:0}
.tagchips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.tg{display:inline-flex;align-items:center;gap:2px;padding:2px 4px 2px 12px;border-radius:999px;background:var(--raised);border:1px solid var(--line);font-weight:600;font-size:13px}
.tg .icon{width:24px;height:24px}
.tagrow{display:flex;gap:8px}
.sug{margin-top:10px;display:flex;flex-direction:column;gap:6px}
.drop{position:relative;display:flex;flex-direction:column;align-items:center;gap:4px;padding:22px 14px;border:1.5px dashed var(--line);border-radius:12px;color:var(--muted);text-align:center;cursor:pointer;font-weight:500}
.drop b{color:var(--text)}
.drop:hover,.drop.over{border-color:var(--accent);color:var(--text)}
.drop input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer}
.drop:focus-within{outline:2px solid var(--accent2);outline-offset:2px}
.thumbs{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}
.thumb{position:relative}
.thumb img{display:block;width:124px;height:82px;object-fit:cover;border-radius:8px;border:1px solid var(--line)}
.thumb .icon{position:absolute;top:4px;right:4px;width:24px;height:24px;background:var(--panel);border:1px solid var(--line)}

/* calendar */
.cal-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:14px}
.cal-nav{display:flex;align-items:center;gap:6px}
.cal-nav h2{font-size:18px;min-width:9.5em;text-align:center}
.cal-sum{display:flex;gap:28px}
.cal-sum span{display:block;color:var(--muted);font-size:12.5px;font-weight:600}
.cal-sum b{font-size:18px}
.cal-show{margin-bottom:14px}
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr)) minmax(0,.9fr);gap:8px}
.cal .dh{color:var(--muted);font-size:12px;font-weight:600;text-align:center;padding:2px 0}
.day{min-height:82px;min-width:0;overflow:hidden;padding:8px 9px;border-radius:10px;border:1px solid var(--line);background:var(--raised);display:flex;flex-direction:column;gap:2px;text-align:left;cursor:pointer}
.day:hover{border-color:var(--muted)}
.day.off{background:transparent;border-color:transparent;cursor:default;pointer-events:none}
.day.up{background:color-mix(in srgb,var(--pos) 12%,var(--panel));border-color:color-mix(in srgb,var(--pos) 40%,var(--line))}
.day.down{background:color-mix(in srgb,var(--neg) 12%,var(--panel));border-color:color-mix(in srgb,var(--neg) 40%,var(--line))}
.day.nt{background:repeating-linear-gradient(135deg,color-mix(in srgb,var(--accent) 12%,var(--raised)) 0 6px,var(--raised) 6px 12px)}
.day.today{box-shadow:inset 0 0 0 2px var(--accent2)}
.day.wk{cursor:default;pointer-events:none;border-color:color-mix(in srgb,var(--accent) 35%,var(--line));background:var(--panel);justify-content:center}
.day .dn{color:var(--muted);font-size:12px;font-weight:600}
.day .dp{font-weight:700;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.day .ds{color:var(--muted);font-size:11.5px;line-height:1.3}
.day .dnt{color:var(--accent2);font-size:11.5px;font-weight:600;margin-top:auto}
@media (max-width:640px){
  .cal{gap:4px}
  .day{min-height:58px;padding:5px 5px}
  .day .ds{display:none}
  .day .dp{font-size:11px}
  .day .dnt{font-size:10px}
  .cal-sum{gap:18px}
}

/* backtest */
.bt-crumb{display:flex;align-items:center;gap:10px;margin-bottom:4px}
.bt-crumb h1{display:flex;align-items:center;gap:6px}
.sessgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px;margin-bottom:16px}
.sesscard{position:relative;text-align:left;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px 18px;cursor:pointer;display:flex;flex-direction:column;gap:10px}
.sesscard:hover{border-color:var(--muted)}
.sesscard .sc-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.sesscard .sc-name{font-weight:700;font-size:15px}
.sesscard .sc-sym{display:inline-block;margin-top:4px;padding:2px 9px;border-radius:999px;background:var(--raised);border:1px solid var(--line);color:var(--muted);font-size:11.5px;font-weight:600}
.sesscard .sc-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px;padding-top:10px;border-top:1px solid var(--line)}
.sesscard .sc-grid div span{display:block;color:var(--muted);font-size:11px}
.sesscard .sc-grid div b{font-size:15px}
.deep{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;margin-top:14px}
.deep .d{background:var(--raised);border:1px solid var(--line);border-radius:12px;padding:11px 13px}
.deep .d span{display:block;color:var(--muted);font-size:11px;font-weight:600}
.deep .d b{font-size:16px}
.deep .d small{display:block;color:var(--muted);font-size:11px;margin-top:1px}
.dist{display:flex;align-items:flex-end;gap:10px;height:160px;margin-top:14px;padding:0 4px}
.distcol{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:6px;height:100%}
.distcol .db{width:100%;max-width:52px;border-radius:6px 6px 0 0;background:var(--raised)}
.distcol .db.pos{background:var(--bar-pos)}.distcol .db.neg{background:var(--bar-neg)}
.distcol .dv{font-size:12px;font-weight:700}
.distcol .dl{color:var(--muted);font-size:11px}
.newsess{display:flex;gap:10px;flex-wrap:wrap}
.newsess input{flex:1;min-width:140px}
.gradebadge{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:8px;border:1px solid var(--line);font-weight:700;font-size:12.5px;background:var(--raised)}

/* day detail cards */
.daycard{margin-bottom:12px}
.daycard:last-child{margin-bottom:0}
.dc-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.dc-head>.num{margin-left:auto}
.pill{display:inline-block;padding:4px 11px;border-radius:999px;background:var(--raised);border:1px solid var(--line);font-size:12px;font-weight:600;color:var(--muted);margin:2px 5px 2px 0}
.quote{margin:10px 0 0;padding:10px 13px;border-left:3px solid var(--accent);background:var(--raised);border-radius:0 8px 8px 0;font-style:italic;color:var(--text)}
.thumb-btn{border:0;padding:0;background:none;cursor:zoom-in;display:block}
.thumb-btn:hover img{filter:brightness(1.08)}

/* lightbox */
dialog#lbdlg{width:min(96vw,1100px);height:min(92vh,760px);max-width:none;padding:0;border-radius:16px}
.lb-wrap{display:flex;flex-direction:column;height:100%}
.lb-bar{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line)}
.lb-pct{min-width:52px;text-align:center;font-weight:700}
.lb-view{flex:1;overflow:auto;display:flex;align-items:center;justify-content:center;background:var(--bg);padding:18px}
.lb-view img{display:block;max-width:100%;max-height:100%;object-fit:contain;transform-origin:center center;border-radius:6px}

.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--text);color:var(--bg);padding:10px 18px;border-radius:999px;font-weight:600;opacity:0;visibility:hidden;pointer-events:none;z-index:50}
.toast.on{opacity:1;visibility:visible}

@media (max-width:860px){
  .app{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr)}
  .side{flex-direction:row;align-items:center;gap:10px;padding:8px 10px;border-right:0;border-bottom:1px solid var(--line);overflow-x:auto;overflow-y:hidden}
  .brand{padding:0}
  .brand div,.side-foot{display:none}
  .nav{flex-direction:row}
  .nav button{padding:9px 12px;white-space:nowrap}
  .main{padding-top:20px}
  .head h1{font-size:22px}
  .form-card .row{grid-template-columns:1fr}
  .brow{grid-template-columns:minmax(70px,100px) minmax(0,1fr) auto;gap:10px}
}
