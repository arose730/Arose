const bdlg=$('#bdlg'),bform=$('#bform');
function bGradeDesc(){const g=bform.elements.grade.value;$('#bGradeDesc').textContent=g?GDESC[g]:'Pick how well you followed your plan.';}
function renderBtModelBox(id,checked){
  const m=S.models.find(x=>x.id===id),box=$('#bModelBox');
  if(!m){box.innerHTML='';return;}
  box.innerHTML=m.items.length
    ?`<div class="mbox">${m.items.map(i=>`<label><input type="checkbox" name="bmchk" value="${esc(i.id)}" ${checked.includes(i.id)?'checked':''}><span>${esc(i.text)}</span></label>`).join('')}</div>`
    :'<p class="hint" style="margin-top:8px">This model has no checks yet. Add some on the Checklists page.</p>';
}
function renderBtShots(){
  $('#bShotBox').innerHTML=`${btDraft.shots.length<3?`<label class="drop"><b>Drop replay screenshots here or click to upload</b><span>PNG or JPG, up to 3 per trade</span><input type="file" name="bshot" accept="image/*" multiple></label>`:'<p class="hint">You have added 3 screenshots, the most a trade can hold.</p>'}
  ${btDraft.shots.length?`<div class="thumbs">${btDraft.shots.map((s,i)=>`<div class="thumb"><img src="${esc(s)}" alt="Chart screenshot ${i+1}"><button type="button" class="icon" data-act="brmshot" data-i="${i}" aria-label="Remove screenshot ${i+1}">${ic('x',14)}</button></div>`).join('')}</div>`:''}`;
}
async function addBtShots(files){
  const err=$('#berr');err.textContent='';
  for(const f of [...files].filter(x=>/^image\//.test(x.type))){
    if(btDraft.shots.length>=3){err.textContent='A trade can hold up to 3 screenshots.';break;}
    try{btDraft.shots.push(await shrink(f));}catch(e){err.textContent='That image could not be read.';}
  }
  renderBtShots();
}
function openBt(sessionId,tradeId){
  const s=S.backtests.find(x=>x.id===sessionId);if(!s)return;
  btSessionId=sessionId;btEditId=tradeId||null;
  const t=tradeId?s.trades.find(x=>x.id===tradeId):null;
  bform.reset();
  const f=bform.elements;
  $('#bdlgTitle').textContent=t?`Edit backtest trade \u00b7 ${esc(s.symbol||s.name)}`:`Log backtest trade \u00b7 ${esc(s.symbol||s.name)}`;
  $('#bSaveBtn').textContent=t?'Save changes':'Log trade';
  f.date.value=t?t.date:ymd(new Date());
  f.model.innerHTML='<option value="">\u2014 none / discretionary \u2014</option>'+S.models.map(m=>`<option value="${esc(m.id)}">${esc(m.name)}</option>`).join('');
  btDraft={shots:t&&t.shots?t.shots.slice():[]};
  let mid='',mchk=[];
  if(t){
    setRadio2(f,'outcome',t.outcome==='missed'?'win':t.outcome);
    f.missed.checked=t.outcome==='missed';
    setRadio2(f,'dir',t.dir==='short'?'short':'long');
    f.r.value=t.r==null?'':Math.abs(t.r);
    f.sim.value=t.sim==null?'':t.sim;
    setRadio2(f,'grade',t.grade||'');
    f.notes.value=t.notes||'';
    if(t.model&&S.models.some(m=>m.id===t.model.id)){mid=t.model.id;mchk=t.mchecked||[];}
  }
  f.model.value=mid;
  renderBtModelBox(mid,mchk);renderBtShots();bGradeDesc();
  $('#berr').textContent='';
  const del=$('#bDelBtn');del.hidden=!t;del.textContent='Delete trade';del.dataset.sure='';
  if(bdlg.showModal)bdlg.showModal();else bdlg.setAttribute('open','');
}
function closeBt(){if(bdlg.close)bdlg.close();else bdlg.removeAttribute('open');btEditId=null;}
function setRadio2(f,name,val){[...f.querySelectorAll(`input[name="${name}"]`)].forEach(r=>{r.checked=r.value===val;});}
