            <label class="o-win"><input type="radio" name="outcome" value="win" checked><span>Win</span></label>
            <label><input type="radio" name="outcome" value="be"><span>Break even</span></label>
            <label class="o-loss"><input type="radio" name="outcome" value="loss"><span>Loss</span></label>
