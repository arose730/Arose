      <div class="t-only">
        <fieldset>
          <legend>Direction</legend>
          <div class="seg full">
            <label><input type="radio" name="dir" value="long" checked><span>Long</span></label>
            <label><input type="radio" name="dir" value="short"><span>Short</span></label>
