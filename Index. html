/* ---------- events ---------- */
const refocus=sel=>{const el=document.querySelector(sel);if(el)el.focus();};
document.addEventListener('click',e=>{
  const b=e.target.closest('[data-act]');if(!b)return;
  const a=b.dataset.act;
  if(a==='nav')go(b.dataset.v);
  else if(a==='log')openTrade();
  else if(a==='edit'){closeDayDetail();openTrade(b.dataset.id);}
  else if(a==='close')closeTrade();
  else if(a==='del'){
    if(b.dataset.sure!=='1'){b.dataset.sure='1';b.textContent='Confirm delete';return;}
    S.trades=S.trades.filter(t=>t.id!==editId);save();closeTrade();render();toast('Trade deleted');
    cloudDeleteTrade(editId);
  }
  else if(a==='filter'){jf=b.dataset.f;render();}
  else if(a==='calprev'){calM--;if(calM<0){calM=11;calY--;}render();refocus('[data-act="calprev"]');}
  else if(a==='calnext'){calM++;if(calM>11){calM=0;calY++;}render();refocus('[data-act="calnext"]');}
  else if(a==='caltoday'){const n=new Date();calY=n.getFullYear();calM=n.getMonth();render();refocus('[data-act="caltoday"]');}
  else if(a==='calshow'){S.calShow=S.calShow||{};S.calShow[b.dataset.k]=!S.calShow[b.dataset.k];save();cloudSyncSettings();render();refocus('[data-act="calshow"][data-k="'+b.dataset.k+'"]');}
  else if(a==='calday')openDayDetail(b.dataset.d);
  else if(a==='ddclose')closeDayDetail();
  else if(a==='ddlog'){const ds=ddlg.dataset.date;closeDayDetail();openTrade(null,ds);}
  else if(a==='zoom')openLightbox(b.dataset.src);
  else if(a==='lbin'){lbScale=Math.min(3,lbScale+0.25);applyLbScale();}
  else if(a==='lbout'){lbScale=Math.max(0.5,lbScale-0.25);applyLbScale();}
  else if(a==='lbreset'){lbScale=1;applyLbScale();}
  else if(a==='lbclose')closeLightbox();
  else if(a==='install'){
    if(!installEvt)return;
    installEvt.prompt();
    installEvt.userChoice.then(r=>{if(r.outcome==='accepted'){installed=true;}installEvt=null;render();});
  }
  else if(a==='btopen'){btSessionId=b.dataset.id;render();$('#main').scrollTop=0;}
  else if(a==='btback'){btSessionId=null;render();$('#main').scrollTop=0;}
  else if(a==='btdelsession'){
    e.stopPropagation();
    if(btDelSure!==b.dataset.id){btDelSure=b.dataset.id;toast('Tap the trash icon again to delete this session');return;}
    S.backtests=S.backtests.filter(x=>x.id!==b.dataset.id);btDelSure=null;save();render();toast('Session deleted');
  }
  else if(a==='btlog')openBt(b.dataset.id);
  else if(a==='btedit')openBt(b.dataset.sid,b.dataset.id);
  else if(a==='bclose')closeBt();
  else if(a==='bdel'){
    if(b.dataset.sure!=='1'){b.dataset.sure='1';b.textContent='Confirm delete';return;}
    const s=S.backtests.find(x=>x.id===btSessionId);
    if(s){s.trades=s.trades.filter(t=>t.id!==btEditId);save();}
    closeBt();render();toast('Backtest trade deleted');
  }
  else if(a==='bdateprev'||a==='bdatenext'){
    const inp=bform.elements.date,d=new Date(inp.value+'T00:00');
    d.setDate(d.getDate()+(a==='bdatenext'?1:-1));inp.value=ymd(d);
  }
  else if(a==='brmshot'){btDraft.shots.splice(+b.dataset.i,1);renderBtShots();$('#berr').textContent='';}
  else if(a==='addtag'){const el=$('#tagIn');addTagsFrom(el.value);renderTags();$('#tagIn').focus();}
  else if(a==='pickTag'){addTagsFrom(b.dataset.t);renderTags();}
  else if(a==='rmtag'){draft.tags=draft.tags.filter(x=>x!==b.dataset.t);renderTags();}
  else if(a==='rmshot'){draft.shots.splice(+b.dataset.i,1);renderShots();$('#ferr').textContent='';}
  else if(a==='rmitem'){S.models.forEach(m=>{m.items=m.items.filter(i=>i.id!==b.dataset.id);});delete S.checked[b.dataset.id];save();cloudSyncSettings();render();}
  else if(a==='rmmodel'){S.models=S.models.filter(m=>m.id!==b.dataset.id);save();cloudSyncSettings();render();toast('Model deleted');}
  else if(a==='resetchecks'){S.checked={};save();cloudSyncSettings();render();}
  else if(a==='clearAsk'){confirmClear=true;render();}
  else if(a==='clearNo'){confirmClear=false;render();}
  else if(a==='clearYes'){
    const ids=S.trades.map(t=>t.id);
    S.trades=[];confirmClear=false;save();render();toast('Entries deleted');
    ids.forEach(cloudDeleteTrade);
  }
});
