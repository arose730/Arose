<body>
<div class="app">
  <aside class="side" id="side"></aside>
  <main class="main" id="main" tabindex="-1"></main>
</div>

<dialog id="dlg" aria-labelledby="dlgTitle">
  <form id="tform" class="dform" novalidate data-mode="trade">
    <div class="dhead">
      <h2 id="dlgTitle">Log a trade</h2>
      <button type="button" class="icon" data-act="close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="dbody">
      <div class="seg tabs" role="radiogroup" aria-label="Entry type">
        <label><input type="radio" name="mode" value="trade" checked><span>I traded today</span></label>
        <label><input type="radio" name="mode" value="none"><span>No trade day</span></label>
      </div>

      <div class="grid2">
        <label class="f">Date<input type="date" name="date" required></label>
        <label class="f t-only">Symbol<input name="symbol" placeholder="XAUUSD, EURUSD, US30" autocomplete="off"></label>
