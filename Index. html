function flushTag(){const el=$('#tagIn');if(el&&el.value.trim()){addTagsFrom(el.value);el.value='';}}

tform.addEventListener('submit',e=>{
  e.preventDefault();
  const f=tform.elements,err=$('#ferr');
  flushTag();
  const mode=f.mode.value,date=f.date.value;
  const feelings=[...tform.querySelectorAll('input[name="feel"]:checked')].map(x=>x.value);
  const old=editId?S.trades.find(x=>x.id===editId):null;
  let t;
  if(mode==='none'){
    if(!date){err.textContent='Add a date to save this day.';return;}
    t={id:old?old.id:uid(),date,noTrade:true,symbol:'',outcome:'',pnl:0,feelings,notes:f.notes.value.trim(),tags:[],shots:[],created:old?old.created:Date.now()};
  }else{
    const symbol=f.symbol.value.trim().toUpperCase(),outcome=f.outcome.value;
    const amt=parseFloat(f.amount.value),needAmt=outcome==='win'||outcome==='loss';
    if(!date||!symbol||(needAmt&&!Number.isFinite(amt))){
      err.textContent=needAmt?'Add a date, a symbol and an amount to save this trade.':'Add a date and a symbol to save this trade.';return;
    }
    const A=Number.isFinite(amt)?Math.abs(amt):0,rv=parseFloat(f.r.value);
    const pnl=outcome==='win'?A:outcome==='loss'?-A:0;
    const r=Number.isFinite(rv)?(outcome==='loss'?-Math.abs(rv):outcome==='be'?0:Math.abs(rv)):null;
    const m=S.models.find(x=>x.id===f.model.value);
    const mchk=[...tform.querySelectorAll('input[name="mchk"]:checked')].map(x=>x.value);
    let model=null,mdone=0,mtotal=0,mchecked=[];
    if(m){model={id:m.id,name:m.name};mtotal=m.items.length;mchecked=mchk;mdone=mchk.length;}
    else if(old&&old.model&&!S.models.some(x=>x.id===old.model.id)){model=old.model;mdone=old.mdone;mtotal=old.mtotal;mchecked=old.mchecked||[];}
    t={id:old?old.id:uid(),date,noTrade:false,symbol,dir:f.dir.value==='short'?'short':'long',outcome,amount:A,r,pnl,
      model,mchecked,mdone,mtotal,grade:f.grade.value||'',conf:parseInt(f.conf.value,10),session:f.session.value||'None',
      feelings,broke:f.broke.checked,tags:draft.tags.slice(),notes:f.notes.value.trim(),shots:draft.shots.slice(),created:old?old.created:Date.now()};
  }
  const prev=JSON.stringify(S.trades);
  if(old)S.trades[S.trades.indexOf(old)]=t;else S.trades.push(t);
  if(!save(true)){
    S.trades=JSON.parse(prev);
    err.textContent='Could not save. Browser storage may be full. Try removing a screenshot.';
    return;
  }
  closeTrade();render();toast(t.noTrade?'No trade day saved':'Trade saved');
  cloudSyncTrade(t);
});
