function tradeRow(t){
  const id=esc(t.id),d=esc(fmtDate(t.date));
  if(t.noTrade){
    return `<tr tabindex="0" data-act="edit" data-id="${id}"><td>${d}</td><td colspan="6"><b>No trade day</b>${t.notes?`<small>${esc(t.notes)}</small>`:''}</td></tr>`;
  }
  const meta=[t.session&&t.session!=='None'?t.session:'',t.model?`${t.model.name} ${t.mdone||0}/${t.mtotal||0}`:'',(t.tags||[]).map(x=>'#'+x).join(' ')].filter(Boolean).join(', ');
  const oc=OUT_LABEL[t.outcome]||'\u2013';
  const pnl=t.outcome==='missed'?`<td class="r num muted">${money(t.amount||0)}</td>`:`<td class="r num ${cls(t.pnl)}"><b>${money(t.pnl,true)}</b></td>`;
  return `<tr tabindex="0" data-act="edit" data-id="${id}">
