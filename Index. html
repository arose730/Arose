  const stats=`<div class="tiles">
    ${tile('Net R',fmtR(st.net),`${st.n} ${st.n===1?'trade':'trades'}`,'trend')}
    ${tile('Win rate',st.n?st.winRate.toFixed(1)+'%':'\u2013',`${st.wins}W / ${st.losses}L`,'target')}
    ${tile('Expectancy',st.n?fmtR(st.exp):'\u2013','R per trade','bolt')}
    ${tile('Avg win / loss',`${st.wins?'+'+st.avgWin.toFixed(2).replace(/\.?0+$/,'')+'R':'0R'} / ${st.losses?'\u2212'+st.avgLoss.toFixed(2).replace(/\.?0+$/,'')+'R':'0R'}`,'Payoff ratio','up')}</div>`;
  const dcell=(l,v,s2,c)=>`<div class="d"><span>${l}</span><b class="num ${c||''}">${v}</b>${s2?`<small>${s2}</small>`:''}</div>`;
