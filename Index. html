function bars(list){
  const mx=Math.max(...list.map(g=>Math.abs(g.net)),1e-9);
  return `<div class="bars">${list.map(g=>`<div class="brow"><div class="bl"><b>${esc(g.k)}</b><small>${g.n} ${g.n===1?'trade':'trades'}, ${Math.round(g.w/g.n*100)}% won</small></div><div class="bbar" aria-hidden="true"><i class="${g.net<0?'neg':'pos'}" style="width:${Math.max(3,Math.abs(g.net)/mx*100).toFixed(1)}%"></i></div><div class="bv num ${cls(g.net)}">${money(g.net,true)}</div></div>`).join('')}</div>`;
}

function vAnalytics(){
  const R=sortTrades(S.trades.filter(isReal));
  if(!R.length){
    return head('Analytics','Patterns in your results')+`<div class="card empty-card"><h2>Nothing to analyse yet</h2><p>Log a few trades and your patterns will show up here.</p><button class="btn primary" data-act="log">${ic('plus',16)}Log trade</button></div>`;
  }
  const st=stats(R);
  let run=0,peak=0,dd=0,ws=0,ls=0,cw=0,cl=0;
  R.forEach(t=>{
    run+=t.pnl;peak=Math.max(peak,run);dd=Math.max(dd,peak-run);
    if(t.pnl>0){cw++;cl=0;}else if(t.pnl<0){cl++;cw=0;}else{cw=0;cl=0;}
    ws=Math.max(ws,cw);ls=Math.max(ls,cl);
  });
  const best=R.reduce((a,b)=>b.pnl>a.pnl?b:a),worst=R.reduce((a,b)=>b.pnl<a.pnl?b:a);
  const rs=R.filter(t=>t.r!=null).map(t=>t.r),avgR=rs.length?rs.reduce((a,b)=>a+b,0)/rs.length:null;
  const broke=R.filter(t=>t.broke).length;
  const missed=S.trades.filter(t=>!t.noTrade&&t.outcome==='missed'),missedAmt=missed.reduce((a,t)=>a+(t.amount||0),0);
  const noDays=S.trades.filter(t=>t.noTrade).length;
  const DAYS=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const DORD=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
  const bySym=group(R,t=>t.symbol).sort((a,b)=>b.net-a.net).slice(0,8);
  const byDay=byOrder(group(R,t=>DAYS[new Date(t.date+'T00:00').getDay()]),DORD);
  const byDir=byOrder(group(R,t=>t.dir==='short'?'Short':'Long'),['Long','Short']);
  const bySess=byOrder(group(R,t=>t.session&&t.session!=='None'?t.session:''),SESS.map(s=>s[0]));
  const byGrade=byOrder(group(R,t=>t.grade?'Grade '+t.grade:''),['S','A','B','C','D','F'].map(g=>'Grade '+g));
  const byRule=byOrder(group(R,t=>t.broke?'Broke a rule':'Followed the rules'),['Followed the rules','Broke a rule']);
  const byModel=group(R,t=>t.model&&t.model.name).sort((a,b)=>b.net-a.net).slice(0,8);
  const byFeel=group(R,t=>t.feelings||[]).sort((a,b)=>b.net-a.net).slice(0,10);
  const card=(title,list)=>list.length?`<section class="card"><h2>${title}</h2>${bars(list)}</section>`:'';
  const fact=(l,v,s,c)=>`<div class="fact"><div class="fl">${l}</div><div class="fv num ${c||''}">${v}</div>${s?`<div class="fs">${s}</div>`:''}</div>`;
  return head('Analytics','Patterns in your results')+`
  <div class="facts">
    ${fact('Net P&amp;L',money(st.net,true),`${st.n} ${st.n===1?'trade':'trades'}`,cls(st.net))}
    ${fact('Best trade',money(best.pnl,true),esc(best.symbol),cls(best.pnl))}
    ${fact('Worst trade',money(worst.pnl,true),esc(worst.symbol),cls(worst.pnl))}
    ${fact('Max drawdown',money(-dd),'Peak to low')}
    ${fact('Longest win streak',String(ws),ws===1?'trade':'trades')}
    ${fact('Longest loss streak',String(ls),ls===1?'trade':'trades')}
    ${avgR!=null?fact('Average R',fmtR(avgR),`${rs.length} ${rs.length===1?'trade':'trades'} with R`,cls(avgR)):''}
    ${fact('Rule breaks',`${broke} of ${R.length}`,'Trades where you broke a rule',broke?'neg':'')}
    ${fact('Missed trades',String(missed.length),missed.length?`${money(missedAmt)} left on the table`:'None logged')}
    ${fact('No trade days',String(noDays),noDays===1?'day':'days')}
  </div>
  <div class="cols2">
    ${card('By symbol',bySym)}${card('By weekday',byDay)}${card('Long and short',byDir)}
    ${card('By session',bySess)}${card('By grade',byGrade)}${card('Following your rules',byRule)}
    ${card('By entry model',byModel)}${card('By feeling',byFeel)}
  </div>`;
}

/* ---------- backtest ---------- */
const DAY_ORD=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
function allBtTrades(){const a=[];S.backtests.forEach(s=>s.trades.forEach(t=>a.push(t)));return a;}
function btSort(trades){return trades.slice().sort((a,b)=>a.date===b.date?(a.created||0)-(b.created||0):(a.date<b.date?-1:1));}
function rStats(trades){
  const rs=trades.filter(t=>t.r!=null).map(t=>t.r);
  const n=rs.length,net=rs.reduce((a,b)=>a+b,0);
  const w=rs.filter(v=>v>0),l=rs.filter(v=>v<0);
  const gw=w.reduce((a,b)=>a+b,0),gl=Math.abs(l.reduce((a,b)=>a+b,0));
  return{n,net,wins:w.length,losses:l.length,
    winRate:n?w.length/n*100:null,exp:n?net/n:0,
    avgWin:w.length?gw/w.length:0,avgLoss:l.length?gl/l.length:0,
    pf:gl>0?gw/gl:(gw>0?Infinity:0)};
}
function deepStats(trades){
  const t=btSort(trades.filter(x=>x.r!=null));
  const rs=t.map(x=>x.r);
  if(!rs.length)return null;
  let run=0,peak=-Infinity,trough=Infinity,dd=0,ru=0,cw=0,cl=0,ws=0,ls=0;
  rs.forEach(v=>{
    run+=v;peak=Math.max(peak,run);dd=Math.max(dd,peak-run);
    ru=Math.max(ru,run-trough);trough=Math.min(trough,run);
    if(v>0){cw++;cl=0;}else if(v<0){cl++;cw=0;}else{cw=0;cl=0;}
    ws=Math.max(ws,cw);ls=Math.max(ls,cl);
  });
  const sorted=rs.slice().sort((a,b)=>a-b);
  const mid=Math.floor(sorted.length/2),median=sorted.length%2?sorted[mid]:(sorted[mid-1]+sorted[mid])/2;
  const mean=rs.reduce((a,b)=>a+b,0)/rs.length;
  const std=Math.sqrt(rs.reduce((a,b)=>a+(b-mean)*(b-mean),0)/rs.length);
  const best=Math.max(...rs),worst=Math.min(...rs);
  const losers=rs.filter(v=>v<0),bigWinners=rs.filter(v=>v>=2);
  const fullStopPct=losers.length?losers.filter(v=>v<=-0.9).length/losers.length*100:0;
  const winRate=rs.filter(v=>v>0).length/rs.length;
  const avgWinR=rs.filter(v=>v>0).length?rs.filter(v=>v>0).reduce((a,b)=>a+b,0)/rs.filter(v=>v>0).length:0;
  const avgLossR=losers.length?Math.abs(losers.reduce((a,b)=>a+b,0)/losers.length):0;
  const payoff=avgLossR>0?avgWinR/avgLossR:0;
  let kelly=payoff>0?winRate-(1-winRate)/payoff:0;kelly=Math.max(0,Math.min(1,kelly))*100;
  const longs=t.length?t.filter(x=>x.dir!=='short').length/t.length*100:0;
  const byDay=group(t,x=>DAY_ORD[new Date(x.date+'T00:00').getDay()]);
  const bestDay=byDay.length?byDay.reduce((a,b)=>b.net>a.net?b:a).k:'\u2013';
  const gw2=rs.filter(v=>v>0).reduce((a,b)=>a+b,0),gl2=Math.abs(losers.reduce((a,b)=>a+b,0));
  const pf=gl2>0?gw2/gl2:(gw2>0?Infinity:0);
  return{n:rs.length,pf,
    dd,ru,best,worst,median,std,ws,ls,pct2R:rs.length?bigWinners.length/rs.length*100:0,
    fullStopPct,kelly,longs,bestDay,sharpe:std>0?mean/std:null};
}
function distBuckets(trades){
  const rs=trades.filter(t=>t.r!=null).map(t=>t.r);
  const B=[{lo:-Infinity,hi:-1.5,lbl:'<\u22121.5R'},{lo:-1.5,hi:-0.5,lbl:'\u22121R'},{lo:-0.5,hi:0.5,lbl:'0R'},{lo:0.5,hi:1.5,lbl:'1R'},{lo:1.5,hi:Infinity,lbl:'2R+'}];
  return B.map(b=>({lbl:b.lbl,n:rs.filter(v=>v>=b.lo&&v<b.hi).length,pos:b.lo>=0}));
}
function rBars(list){
  const mx=Math.max(...list.map(g=>Math.abs(g.net)),1e-9);
  return `<div class="bars">${list.map(g=>`<div class="brow"><div class="bl"><b>${esc(g.k)}</b><small>${g.n} ${g.n===1?'trade':'trades'}${g.w!=null?`, ${Math.round(g.w/g.n*100)}% won`:''}</small></div><div class="bbar" aria-hidden="true"><i class="${g.net<0?'neg':'pos'}" style="width:${Math.max(3,Math.abs(g.net)/mx*100).toFixed(1)}%"></i></div><div class="bv num ${cls(g.net)}">${fmtR(g.net)}</div></div>`).join('')}</div>`;
}
function rCurveSvg(trades){
  const t=btSort(trades.filter(x=>x.r!=null));
  let b=0;const pts=[0];t.forEach(x=>{b+=x.r;pts.push(b);});
  const W=760,H=230,L=54,R=16,Tp=14,B=26;
  let mn=Math.min(0,...pts),mx=Math.max(0,...pts);if(mn===mx){mn-=1;mx+=1;}
  const pad=(mx-mn)*.12;mn-=pad;mx+=pad;
  const X=i=>L+(W-L-R)*i/(pts.length-1);
  const Y=v=>Tp+(H-Tp-B)*(1-(v-mn)/(mx-mn));
  const line=pts.map((v,i)=>(i?'L':'M')+X(i).toFixed(1)+' '+Y(v).toFixed(1)).join(' ');
  const last=pts.length-1,area=line+` L${X(last).toFixed(1)} ${H-B} L${L} ${H-B} Z`;
  let grid='';
  for(let i=0;i<=4;i++){const v=mn+(mx-mn)*i/4,y=Y(v).toFixed(1);grid+=`<line class="gl" x1="${L}" x2="${W-R}" y1="${y}" y2="${y}"/><text x="${L-8}" y="${(+y)+4}" text-anchor="end">${fmtR(v)}</text>`;}
  const up=pts[last]>=0;
  return `<svg class="chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="Cumulative R from 0 to ${fmtR(pts[last])} over ${t.length} trades">${grid}<path class="area" d="${area}"/><path class="ln" d="${line}"/><circle class="dot ${up?'pos':'neg'}" cx="${X(last).toFixed(1)}" cy="${Y(pts[last]).toFixed(1)}" r="4.5"/></svg>`;
}
function distSvg(trades){
  const b=distBuckets(trades),mx=Math.max(...b.map(x=>x.n),1);
  return `<div class="dist">${b.map(x=>`<div class="distcol"><span class="dv num">${x.n}</span><div class="db ${x.n?(x.pos?'pos':'neg'):''}" style="height:${x.n?Math.max(6,x.n/mx*100):2}%"></div><span class="dl">${esc(x.lbl)}</span></div>`).join('')}</div>`;
}

