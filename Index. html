<script>
(()=>{
'use strict';
const $=(s,r=document)=>r.querySelector(s);
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid=()=>Math.random().toString(36).slice(2,9)+Date.now().toString(36).slice(-3);
const ymd=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const sum=a=>a.reduce((s,t)=>s+(typeof t==='number'?t:t.pnl),0);
const cls=n=>n>0?'pos':n<0?'neg':'';

/* ---------- constants ---------- */
const GRADES=['F','D','C','B','A','S'];
const GDESC={S:'Textbook trade, planned and executed',A:'Followed the plan well',B:'Solid, with one small slip',C:'Average, some rules bent',D:'Poor execution',F:'Ignored the plan'};
const SESS=[['NY AM','NY AM'],['NY PM','NY PM'],['London','London'],['Asia','Asia'],['None','No session']];
const FEEL_POS=['Disciplined','Calm','Patient','Focused','Confident'];
const FEEL_NEG=['Hesitant','Doubtful','Anxious','Distracted','Impatient','FOMO','Greedy','Frustrated','Angry','Revenge urge'];
const OUT_LABEL={win:'Win',loss:'Loss',be:'Break even',missed:'Missed'};

/* ---------- storage ---------- */
const KEY='trading-journal:v1';
let persisted=true;
const defaults=()=>({
  name:'Arose TradeLab',cur:'$',start:0,theme:'dark',trades:[],
  models:[{id:'m1',name:'My entry model',items:[
    {id:'c1',text:'The setup matches my written plan'},
    {id:'c2',text:'My stop-loss is placed before I enter'},
    {id:'c3',text:'The risk is within my limit for one trade'},
    {id:'c4',text:'I checked the higher timeframe'}
  ]}],
  checked:{},
  calShow:{pnl:true,trades:true,wl:false,winp:false,r:false,be:false,notrade:true,grade:false},
  backtests:[]
});
function migrate(t){
  if(t.noTrade||t.outcome!==undefined)return t;
  const p=+t.pnl||0;
  return Object.assign({},t,{dir:t.dir||t.side||'long',outcome:p>0?'win':p<0?'loss':'be',amount:Math.abs(p),r:null,
    model:null,mchecked:[],mdone:0,mtotal:0,grade:'',conf:null,session:'',feelings:[],broke:false,
    tags:t.setup?[t.setup]:[],shots:[]});
}
function load(){
  try{
    localStorage.setItem(KEY+':probe','1');localStorage.removeItem(KEY+':probe');
    const r=localStorage.getItem(KEY);
    if(r){
      const d=JSON.parse(r);
      if(d&&typeof d==='object'){
        const o=Object.assign(defaults(),d);
        if(!Array.isArray(d.models)){
          o.models=[{id:'m1',name:'My entry model',items:Array.isArray(d.checklist)?d.checklist:defaults().models[0].items}];
        }
        delete o.checklist;
        o.trades=(Array.isArray(o.trades)?o.trades:[]).map(migrate);
        return o;
      }
    }
  }catch(e){persisted=false;}
  return defaults();
}
let S=load();
function save(quiet){
  try{localStorage.setItem(KEY,JSON.stringify(S));return true;}
  catch(e){if(!quiet)toast('Could not save. Browser storage may be full.');return false;}
}

/* ---------- formatting ---------- */
const money=(n,sign)=>{
  const a=Math.abs(n)||0;
  const s=a.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});
  return (n<0&&a>=0.005?'\u2212':(sign&&n>0?'+':''))+esc(S.cur)+s;
};
const compact=v=>{
  const a=Math.abs(v);
  const s=a>=1e6?(a/1e6).toFixed(1)+'M':a>=1e3?(a/1e3).toFixed(1)+'k':a.toFixed(a<10&&a%1?1:0);
  return (v<0?'\u2212':'')+esc(S.cur)+s;
};
const fmtR=r=>r==null?'\u2013':(r>0?'+':'')+(+r).toFixed(2).replace(/\.?0+$/,'')+'R';
const fmtDate=s=>new Date(s+'T00:00').toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'});
const sortTrades=T=>T.slice().sort((a,b)=>a.date===b.date?(a.created||0)-(b.created||0):(a.date<b.date?-1:1));
const isReal=t=>!t.noTrade&&t.outcome!=='missed';

/* ---------- icons ---------- */
const ICON={
  dashboard:'<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
  journal:'<path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H20v15H5.5A1.5 1.5 0 0 0 4 19.5v-15Z"/><path d="M4 19.5A1.5 1.5 0 0 0 5.5 21H20v-3"/>',
  analytics:'<path d="M5 20v-9M12 20V4M19 20v-6"/>',
  checklists:'<path d="M9 6h11M9 12h11M9 18h11"/><path d="m3.5 6 1.2 1.2L6.5 5M3.5 12l1.2 1.2L6.5 11M3.5 18l1.2 1.2L6.5 17"/>',
  backtest:'<path d="M9 3h6M10 3v6.3L4.6 18.8A1.8 1.8 0 0 0 6.2 21.5h11.6a1.8 1.8 0 0 0 1.6-2.7L14 9.3V3"/><path d="M7.5 14.5h9"/>',
  settings:'<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',
  plus:'<path d="M12 5v14M5 12h14"/>',
  target:'<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
  trend:'<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  up:'<path d="M7 17 17 7M8 7h9v9"/>',
  bolt:'<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  left:'<path d="m15 6-6 6 6 6"/>',
  right:'<path d="m9 6 6 6-6 6"/>',
  edit:'<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  trash:'<path d="M4 7h16M9 7V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V7M18 7l-.8 12a2 2 0 0 1-2 1.9H8.8a2 2 0 0 1-2-1.9L6 7"/>',
  back:'<path d="M19 12H5M11 18l-6-6 6-6"/>',
  x:'<path d="M6 6l12 12M18 6 6 18"/>'
};
const ic=(n,s)=>`<svg viewBox="0 0 24 24" width="${s||18}" height="${s||18}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[n]}</svg>`;
const MARK='<span class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 4v16M12 8v10M17 3v14"/></svg></span>';

/* ---------- stats ---------- */
function stats(T){
  const w=T.filter(t=>t.pnl>0),l=T.filter(t=>t.pnl<0);
  const gw=sum(w),gl=Math.abs(sum(l)),n=T.length,net=sum(T);
  return{n,wins:w.length,losses:l.length,net,gw,gl,
    winRate:n?w.length/n*100:null,
    pf:gl>0?gw/gl:(gw>0?Infinity:0),
    avgWin:w.length?gw/w.length:0,avgLoss:l.length?gl/l.length:0,
    exp:n?net/n:0};
}
function group(T,keyFn){
  const m=new Map();
  T.forEach(t=>{
    [].concat(keyFn(t)).forEach(k=>{
      if(!k)return;
      const g=m.get(k)||{k,net:0,n:0,w:0};g.net+=t.pnl;g.n++;if(t.pnl>0)g.w++;m.set(k,g);
    });
  });
  return [...m.values()];
}
const byOrder=(arr,ord)=>arr.sort((a,b)=>ord.indexOf(a.k)-ord.indexOf(b.k));

/* ---------- state ---------- */
let view='dashboard',jf='all',confirmClear=false,editId=null,tt=null;
let btSessionId=null,btEditId=null,btDraft={shots:[]},btDelSure=null;
