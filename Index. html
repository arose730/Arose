/* ---------- cloud account ---------- */
function cloudSyncTrade(t){
  if(!cloudOn||cloudBlocked||!cloudTradesCol)return;
  cloudTradesCol.doc(t.id).set(t).then(()=>{touchMember();}).catch(err=>{
    if(err&&err.code==='invalid_argument'){cloudBlocked=true;toast('That screenshot is too large to save to your account; kept on this device only.');}
    else{cloudBlocked=true;toast('Could not save to your account; kept on this device only.');}
    if(view==='settings')render();else renderSide();
  });
}
function cloudDeleteTrade(id){
  if(!cloudOn||cloudBlocked||!cloudTradesCol||!id)return;
  cloudTradesCol.doc(id).delete().then(()=>{touchMember();}).catch(()=>{});
}
function touchMember(){
  if(!cloudDb||!cloudUid)return;
  cloudDb.doc('members/'+cloudUid).set({tradeCount:S.trades.filter(isReal).length,lastActive:new Date().toISOString()}).catch(()=>{});
}
function cloudSyncSettings(){
  if(!cloudOn||cloudBlocked||!cloudDoc)return;
  cloudDoc.set({name:S.name,cur:S.cur,start:S.start,theme:S.theme,models:S.models,checked:S.checked,calShow:S.calShow}).catch(err=>{
    cloudBlocked=true;toast('Could not save to your account; kept on this device only.');
    if(view==='settings')render();else renderSide();
  });
}
async function initCloud(){
  try{
    const userCap=await claude.use('user');if(!userCap)return;
    const me=await userCap.me();if(!me||!me.id)return;
    const dbCap=await claude.use('db');if(!dbCap)return;
    cloudUid=me.id;cloudName=me.name||'';cloudAvatar=me.avatarUrl||'';
    cloudDb=dbCap;cloudUserCap=userCap;cloudIsOwner=!!(await userCap.isOwner());
    cloudDoc=dbCap.doc('data/users/'+cloudUid+'/journal');
    cloudTradesCol=cloudDoc.collection('trades');
    cloudOn=true;
    const snap=await cloudDoc.get();
    if(snap.exists){
      const d=snap.data()||{};
      if(d.name!=null)S.name=d.name;
      if(d.cur!=null)S.cur=d.cur;
      if(d.start!=null)S.start=d.start;
      if(d.theme!=null)S.theme=d.theme;
      if(Array.isArray(d.models)&&d.models.length)S.models=d.models;
      if(d.checked)S.checked=d.checked;
      if(d.calShow)S.calShow=Object.assign({},S.calShow,d.calShow);
      applyTheme();
    }else{
      await cloudDoc.set({name:S.name,cur:S.cur,start:S.start,theme:S.theme,models:S.models,checked:S.checked,calShow:S.calShow}).catch(()=>{});
    }
    const tsnap=await cloudTradesCol.get();
    if(!tsnap.empty){
      S.trades=tsnap.docs.map(d=>migrate(d.data()));
    }else if(S.trades.length){
      for(const t of S.trades){await cloudTradesCol.doc(t.id).set(t).catch(()=>{});}
    }
    save(true);render();renderSide();
    dbCap.doc('members/'+cloudUid).set({tradeCount:S.trades.filter(isReal).length,lastActive:new Date().toISOString()}).catch(()=>{});
    cloudTradesCol.onSnapshot(qsnap=>{
      S.trades=qsnap.docs.map(d=>migrate(d.data()));save(true);
      if(view==='dashboard'||view==='journal'||view==='analytics')render();
    },()=>{});
    cloudDoc.onSnapshot(dsnap=>{
      if(!dsnap.exists)return;
      const d=dsnap.data()||{};
      if(d.name!=null)S.name=d.name;if(d.cur!=null)S.cur=d.cur;if(d.start!=null)S.start=d.start;
      if(d.theme!=null){S.theme=d.theme;applyTheme();}
      if(Array.isArray(d.models))S.models=d.models;if(d.checked)S.checked=d.checked;
      if(d.calShow)S.calShow=Object.assign({},S.calShow,d.calShow);
      save(true);renderSide();
      if(view==='settings'||view==='checklists'||view==='dashboard')render();
    },()=>{});
  }catch(e){/* stay in local-only mode */}
}

async function loadMembers(){
  if(!cloudDb||!cloudUserCap||membersLoading)return;
  membersLoading=true;memberErr='';
  try{
    const snap=await cloudDb.collection('members').get();
    const ids=snap.docs.map(d=>d.id);
    const profiles=await cloudUserCap.profiles(ids);
    const rows=[];
    for(const d of snap.docs){
      const id=d.id,meta=d.data()||{};
      let netPnl=0,winRate=null,n=0;
      try{
        const tsnap=await cloudDb.doc('data/users/'+id+'/journal').collection('trades').get();
        const trades=tsnap.docs.map(x=>migrate(x.data())).filter(isReal);
        n=trades.length;
        if(n){const st=stats(trades);netPnl=st.net;winRate=st.winRate;}
      }catch(e2){/* not visible; skip stats for this member */}
      const p=profiles[id]||{name:'',avatarUrl:''};
      rows.push({id,name:p.name,avatarUrl:p.avatarUrl,isMe:id===cloudUid,tradeCount:n,netPnl,winRate,lastActive:meta.lastActive||null});
    }
    rows.sort((a,b)=>(b.lastActive||'').localeCompare(a.lastActive||''));
    memberRows=rows;
  }catch(e){memberErr='Could not load members right now.';}
  membersLoading=false;
  if(view==='settings')render();
}
function membersCard(){
  if(!cloudIsOwner)return'';
  if(memberRows===null&&!membersLoading)loadMembers();
  const rows=memberRows||[];
  const list=rows.length?`<div class="tblwrap"><table class="tbl"><thead><tr><th>Person</th><th class="r">Trades</th><th class="r">Net P&amp;L</th><th class="r">Win rate</th></tr></thead><tbody>${rows.map(r=>`<tr><td>${esc(r.name||'Someone')}${r.isMe?' <span class="hint">(you)</span>':''}</td><td class="r num">${r.tradeCount}</td><td class="r num ${cls(r.netPnl)}">${r.tradeCount?money(r.netPnl,true):'\u2013'}</td><td class="r num">${r.winRate!=null?r.winRate.toFixed(0)+'%':'\u2013'}</td></tr>`).join('')}</tbody></table></div>`
    :(membersLoading?'<p class="empty">Loading members\u2026</p>':memberErr?`<p class="empty">${esc(memberErr)}</p>`:'<p class="empty">Nobody else has opened this yet.</p>');
  return `<section class="card"><h2>Members</h2><p class="note">Everyone who has opened this journal through your account. You can see their activity here; manage who has access from the Share button on the artifact.</p>${list}</section>`;
}

applyTheme();
render();
initCloud();
})();
</script>
