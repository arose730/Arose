    ${dcell('Win streak',String(deep.ws),'Longest run of wins')}
    ${dcell('Loss streak',String(deep.ls),'Longest run of losses')}
    ${dcell('\u22652R winners',deep.pct2R.toFixed(0)+'%','Of all trades')}
    ${dcell('Full stops',deep.fullStopPct.toFixed(0)+'%','Losers near \u22121R')}
    ${dcell('Kelly size',deep.kelly.toFixed(0)+'%','Theoretical max risk')}
    ${dcell('Longs',deep.longs.toFixed(0)+'%','Share of trades')}
    ${dcell('Best day',esc(deep.bestDay),`${(group(s.trades,t=>DAY_ORD[new Date(t.date+'T00:00').getDay()]).find(g=>g.k===deep.bestDay)||{n:0}).n} trades`)}
  </div></section>`:'';
  const charts=deep?`<div class="cols2">
    <section class="card"><h2>Cumulative R curve</h2>${rCurveSvg(s.trades)}</section>
